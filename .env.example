# ──────────────────────────────────────────────
# MvpMonitoreo — Variables de entorno
# ──────────────────────────────────────────────
# Equivalente al .env de Laravel.
# NUNCA subir este archivo a Git (.gitignore)

# PostgreSQL — misma conexión que usas en Laravel
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mvp_monitoreo
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Pool de conexiones async
DB_POOL_MIN=2    # Conexiones mínimas siempre activas
DB_POOL_MAX=10   # Conexiones máximas simultáneas

# Aplicación
APP_ENV=development   # development | production
APP_DEBUG=true

# ──────────────────────────────────────────────
# Alertas Telegram
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
